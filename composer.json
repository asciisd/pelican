{
  "name": "asciisd/copytrade",
  "description": "CopyTrade Laravel SDK",
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Asciisd\\Copytrade\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Asciisd\\Copytrade\\CopytradeServiceProvider"
      ],
      "aliases": {
        "Copytrade": "Asciisd\\Copytrade\\Facades\\Copytrade"
      }
    }
  }
}
