{
  "name": "asciisd/pelican",
  "description": "Pelican Laravel SDK - a Laravel package for integrating with the CopyTrade (Pelican) API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "pelican",
    "copytrade",
    "copy-trading",
    "trading",
    "sdk",
    "api-client"
  ],
  "homepage": "https://github.com/asciisd/pelican",
  "support": {
    "issues": "https://github.com/asciisd/pelican/issues",
    "source": "https://github.com/asciisd/pelican"
  },
  "authors": [
    {
      "name": "ASCIISD",
      "email": "support@asciisd.com",
      "homepage": "https://asciisd.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Asciisd\\Copytrade\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Asciisd\\Copytrade\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Asciisd\\Copytrade\\CopytradeServiceProvider"
      ],
      "aliases": {
        "Copytrade": "Asciisd\\Copytrade\\Facades\\Copytrade"
      }
    }
  }
}
